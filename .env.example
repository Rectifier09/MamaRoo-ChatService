# Copy this file to .env and fill in your values
DATABASE_URL=postgresql://user:password@host:5432/railway
REDIS_URL=redis://user:password@host:6379
ADMIN_API_KEY=choose-a-long-random-string

# --- LLM provider ---
# Which provider serves each role. Defaults to "anthropic" for both if unset.
# Options: anthropic (default), openai, gemini, groq. See llm_provider.py to add
# another — any OpenAI-compatible gateway is a 4-line subclass.
# LLM_PROVIDER=anthropic
# REWRITE_PROVIDER=anthropic
# ANSWER_PROVIDER=anthropic

# Only the key(s) matching your selected provider(s) actually need a real value.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
GROQ_API_KEY=gsk_...

# Model names are provider-specific — these two defaults are Anthropic model names.
# If you switch REWRITE_PROVIDER/ANSWER_PROVIDER to "openai", set these to a current
# OpenAI model instead (check platform.openai.com/docs/models), e.g.:
#   REWRITE_MODEL=gpt-5.4-mini
#   ANSWER_MODEL=gpt-5.4
# If you switch to "gemini", check ai.google.dev/gemini-api/docs/models for the
# current model catalog — names go stale fast, verify against the live account:
#   REWRITE_MODEL=gemini-flash-latest
#   ANSWER_MODEL=gemini-flash-latest
# If you switch to "groq", check console.groq.com/docs/models for the current
# catalog (these churn fast — a prior model here was retired mid-project):
#   REWRITE_MODEL=openai/gpt-oss-120b
#   ANSWER_MODEL=openai/gpt-oss-120b
# REWRITE_MODEL=claude-haiku-4-5-20251001
# ANSWER_MODEL=claude-sonnet-5

# Hotswitching ANSWER_PROVIDER between gemini/groq (e.g. when one hits its
# free-tier daily quota) needs only these two lines changed together — nothing
# in the code:
#   ANSWER_PROVIDER=groq
#   ANSWER_MODEL=openai/gpt-oss-120b
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4
# CACHE_MAX_DISTANCE=0.08
# MAX_HISTORY_TURNS=6
# DEFAULT_RATE_LIMIT_PER_MINUTE=30
# CACHE_TTL_SECONDS=86400
